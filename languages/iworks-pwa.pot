#. translators: %1$s: open anchor tag, %2$s: close anchor tag
#: etc/options.php:141
#, php-format
msgid "Service workers act as a proxy between your app and the network, enabling features like offline support. Increment this number to force update the service worker cache, which is particularly useful after making changes to your PWA files or when you want to ensure all users receive the latest version. When updated, the service worker will automatically install the new version in the background and activate it once all tabs using the old version are closed. %1$sLearn more about service workers%2$s."
msgstr ""

#: etc/options.php:153
msgid "Cache Time"
msgstr ""

#: etc/options.php:157
msgid "Cache time in seconds. Default is 1 day. This controls how long the plugin's configuration is cached using WordPress transient cache. When the cache expires, the plugin will regenerate its configuration on the next page load."
msgstr ""

#: etc/options.php:163
msgid "Offline Content Page"
msgstr ""

#: etc/options.php:164
msgid "This content will be displayed when the user is offline and the requested page is not available in the cache. You can use plain text or HTML. This is your opportunity to provide helpful information or navigation options to users when they lose their internet connection."
msgstr ""

#: etc/options.php:167
#: includes/iworks/class-iworks-pwa.php:720
msgid "We were unable to load the page you requested."
msgstr ""

#: etc/options.php:170
#: includes/iworks/class-iworks-pwa.php:723
msgid "Please check your network connection and try again."
msgstr ""

#: etc/options.php:183
msgid "Runtime Cache Strategy"
msgstr ""

#: etc/options.php:184
msgid "How visited pages are cached by the service worker. \"Network first\" always tries the network and works offline after the first visit. \"Stale-while-revalidate\" shows the cached page instantly and refreshes it in the background. \"Cache first\" is fastest but may show outdated content."
msgstr ""

#: etc/options.php:186
msgctxt "cache strategy"
msgid "Network first (recommended)"
msgstr ""

#: etc/options.php:187
msgctxt "cache strategy"
msgid "Stale-while-revalidate"
msgstr ""

#: etc/options.php:188
msgctxt "cache strategy"
msgid "Cache first"
msgstr ""

#: etc/options.php:197
msgid "Exclude URLs from Caching"
msgstr ""

#: etc/options.php:198
msgid "One regular expression per line. URLs matching any pattern are never cached and bypass the service worker completely. For example: cart, checkout or my-account pages, or dynamic requests. The patterns are matched against the request path."
msgstr ""

